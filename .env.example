# Sao chép thành .env rồi sửa:  cp .env.example .env && chmod 600 .env
# KHÔNG commit file .env. Hướng dẫn đầy đủ: docs/DEPLOY.md

# ----- Bắt buộc -----
# Mật khẩu database (tự tạo):  openssl rand -hex 24
POSTGRES_PASSWORD=doi_mat_khau_nay
# Khóa bí mật của server (tự tạo):  openssl rand -base64 48
SECRET_KEY_BASE=doi_khoa_nay_thanh_chuoi_ngau_nhien_dai_it_nhat_64_ky_tu_xxxxxxxxxxxxxxxxxxxx

# ----- Cách 1: chỉ có IP, chưa có domain (http, không mã hóa) -----
PHX_HOST=203.0.113.10
PHX_SCHEME=http
PHX_URL_PORT=4000
# APP_PORT=4000              # cổng mở ra ngoài; đổi thành 80 thì PHX_URL_PORT=80

# ----- Cách 2: có domain, Caddy làm TLS proxy (khuyên dùng) -----
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# PHX_HOST=game.example.com
# PHX_SCHEME=https
# PHX_URL_PORT=443
# TRUSTED_PROXIES=172.16.0.0/12

# ----- Cách 3: có domain, nginx cài trên VPS làm TLS proxy -----
# PHX_HOST=game.example.com
# PHX_SCHEME=https
# PHX_URL_PORT=443
# APP_BIND=127.0.0.1
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# ----- Thêm cho Cloudflare (đám mây cam) đứng trước Caddy: xem docs/DEPLOY.md -----
# CADDY_TRUSTED_PROXIES=<các dải IP của Cloudflare, cách nhau bởi dấu cách>
# TRUSTED_PROXIES=172.16.0.0/12,<các dải IP của Cloudflare, cách nhau bởi dấu phẩy>

# ----- Tùy chọn -----
# Vừa vào bằng IP vừa bằng domain (lúc chuyển đổi): liệt kê mọi địa chỉ trang game
# CHECK_ORIGIN=https://game.example.com,http://203.0.113.10:4000
# PHX_IPV6=true              # nghe cả IPv6 (chỉ khi Docker đã bật IPv6)
